{
  "expo": {
    "name": "AStech Store",
    "slug": "astech-react-native",
    "scheme": "astech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amirsali.astechstore"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.amirsali.astechstore"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "author": {
        "name": "Amirsali",
        "github": "https://github.com/muhallimir"
      },
      "eas": {
        "projectId": "43087935-83ea-4a1f-847b-2c803e1cd270"
      }
    },
    "owner": "amirsali"
  }
}
